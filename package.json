{
  "name": "vscode-cc-deepseek-stats",
  "displayName": "Claude Code DeepSeek Stats",
  "description": "Claude Code 实时统计面板 — Token 消耗、缓存命中率、费用追踪，支持 DeepSeek 平台余额",
  "version": "1.1.0",
  "icon": "media/icon.png",
  "publisher": "Lee-x222",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lee-x222/vscode-cc-deepseek-stats"
  },
  "bugs": {
    "url": "https://github.com/Lee-x222/vscode-cc-deepseek-stats/issues"
  },
  "homepage": "https://github.com/Lee-x222/vscode-cc-deepseek-stats#readme",
  "keywords": [
    "claude",
    "claude code",
    "claude-code",
    "cc",
    "deepseek",
    "deep seek",
    "deep-seek",
    "token",
    "cost",
    "usage",
    "stats",
    "statistics",
    "monitor",
    "dashboard",
    "tracker",
    "panel",
    "sidebar",
    "balance",
    "api",
    "cache",
    "pricing",
    "deepseek-stats"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:vscode-cc-deepseek-stats.panel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vscode-cc-deepseek-stats-container",
          "title": "Claude Code DeepSeek Stats",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vscode-cc-deepseek-stats-container": [
        {
          "type": "webview",
          "id": "vscode-cc-deepseek-stats.panel",
          "name": ""
        }
      ]
    },
    "commands": [
      {
        "command": "vscode-cc-deepseek-stats.refresh",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "vscode-cc-deepseek-stats.openPanel",
        "title": "打开 CC 侧边面板"
      },
      {
        "command": "vscode-cc-deepseek-stats.exportCSV",
        "title": "导出 CSV 消耗明细"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.4.0"
  }
}
